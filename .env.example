# Copy this to .env and fill in real values. NEVER commit .env.

# ── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=credit_tracker
DB_USER=credit_user
DB_PASSWORD=change-me

# ── Auth ────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
JWT_EXPIRES_DAYS=30

# ── Admin bootstrap (used only on an empty users table) ─────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_NAME=Admin

# ── Frontend origins allowed by CORS (dev only; same-origin in prod via Caddy) ─
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── S3 backups (prod only) ──────────────────────────────────
# S3_BACKUP_BUCKET=shiv-diary-backups
